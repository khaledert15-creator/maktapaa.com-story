NODE_ENV=production
PORT=5001
POSTGRES_DB=maktaba_store
POSTGRES_USER=maktaba_store
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://maktaba_store:replace-with-the-same-password@postgres:5432/maktaba_store
SESSION_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=https://store.maktabaa.com
PUBLIC_SITE_URL=https://store.maktabaa.com
API_URL=https://store.maktabaa.com/api
COOKIE_DOMAIN=store.maktabaa.com
TRUST_PROXY=1
BUILD_VERSION=replace-with-git-sha
STORE_GATEWAY_PORT=19080

DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
DB_APPLICATION_NAME=maktaba-store-api

STORAGE_PROVIDER=local
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=true
STORAGE_LOCAL_DIR=/app/uploads
EMAIL_PROVIDER=disabled
ALLOW_DISABLED_EMAIL_IN_PRODUCTION=true
SEARCH_INDEXING_ENABLED=false
ANALYTICS_ENABLED=false
VITE_ANALYTICS_ENABLED=false
WEBSITE_CHAT_ENABLED=false
LOG_LEVEL=info
ADMIN_IDLE_TIMEOUT_MS=14400000

GOOGLE_TRACKING_SHEET_ID=1sJUQHN13YcSvhbFA0vMha4OoI0AkDNX6dfDe1r9UFds
GOOGLE_TRACKING_SHEET_GID=245379965
