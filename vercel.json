{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm --filter @workspace/maktaba build",
  "outputDirectory": "artifacts/maktaba/dist/public",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/[...path].ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
