# PostgreSQL is required. Do not use SQLite for this project.
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/maktaba_dev

# Local API defaults
PORT=5001
SESSION_SECRET=replace-with-a-long-random-development-secret

# Comma-separated exact browser origins. Set this to the public HTTPS domain in production.
CORS_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
API_URL=http://localhost:5001
TRUST_PROXY=0

# PostgreSQL pool
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Local development stores generated WebP variants under uploads/.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

# Development mail writes the reset URL to structured local logs only.
EMAIL_PROVIDER=log
BUILD_VERSION=development
ADMIN_IDLE_TIMEOUT_MS=14400000

# Read-only Google Sheet used by the customer shipment tracking page.
GOOGLE_TRACKING_SHEET_ID=1sJUQHN13YcSvhbFA0vMha4OoI0AkDNX6dfDe1r9UFds
GOOGLE_TRACKING_SHEET_GID=245379965

# Optional analytics. Nothing is loaded or sent while disabled or IDs are empty.
ANALYTICS_ENABLED=false
VITE_ANALYTICS_ENABLED=false
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_TIKTOK_PIXEL_ID=

# Custom website live chat backed by a Chatwoot API inbox. Disabled until the
# real inbox is provisioned; never expose these values in VITE_* variables.
WEBSITE_CHAT_ENABLED=false
WEBSITE_CHAT_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
WEBSITE_CHAT_ATTACHMENT_MAX_BYTES=5242880
WEBSITE_CHAT_FALLBACK_POLL_MS=15000
CHATWOOT_BASE_URL=
CHATWOOT_REALTIME_URL=
CHATWOOT_API_INBOX_IDENTIFIER=
CHATWOOT_HMAC_TOKEN=
CHATWOOT_REQUEST_TIMEOUT_MS=8000

# Used only by the one-time chatwoot:provision command, not normal API traffic.
CHATWOOT_ACCOUNT_ID=
CHATWOOT_ACCOUNT_ACCESS_TOKEN=
